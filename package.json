{
  "name": "yonja",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "lint": "eslint . && biome lint .",
    "lint:fix": "eslint . --fix && biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm e2e",
    "ship": "pnpm build && firebase deploy --only hosting,firestore:rules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.10.1",
    "firebase": "^13.1.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jiti": "^2.7.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
