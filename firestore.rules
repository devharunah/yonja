rules_version = '2';

// Hackathon demo: no auth yet, so reads and writes are open until the date below.
// Firebase Auth and App Check are on the roadmap and replace this.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
